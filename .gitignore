.venv/
venv/
env/
__pycache__/
*.py[cod]

# PySpice / ngspice 运行产物
*.raw
*.log
spinit

# matplotlib 缓存
mplcache/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 说明：本机专属的忽略项（学习笔记、个人材料等）不写在这里，而是放在 .git/info/exclude，
#       免得那些文件名随仓库公开。本文件只保留「换台机器 clone 下来也需要」的通则。
